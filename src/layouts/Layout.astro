---
import '../styles/global.css';
import {asset,products,about} from '../lib/content';
import Icon from '../components/Icon.astro';
const {title,description='MiBank public informational website redesign. Non-production preview.'}=Astro.props;
const base=import.meta.env.BASE_URL.replace(/\/$/,'');
const current=(Astro.url.pathname.startsWith(base+'/')?Astro.url.pathname.slice(base.length):Astro.url.pathname).replace(/\/$/,'')||'/';
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="robots" content="noindex, nofollow"/><meta name="description" content={description}/><meta name="theme-color" content="#ffe000"/><meta property="og:title" content={`${title} | MiBank`}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/><title>{title} | MiBank</title><link rel="preload" as="font" href="/assets/manrope-latin.woff2" type="font/woff2" crossorigin/><link rel="icon" href="/favicon.svg" type="image/svg+xml"/></head><body>
<noscript><style>@media(max-width:800px){.site-header{position:static}.header-inner{height:auto;flex-wrap:wrap;padding-block:20px}#primary-nav{display:block;position:static;max-height:none;width:100%;padding-inline:0}.mobile-toggle{display:none}.location-directory .directory-filters{display:none}}</style></noscript><a class="skip-link" href="#main">Skip to content</a>
<div class="preview-bar">Independent redesign preview <span>— informational only · no banking transactions</span></div>
<div class="utility"><div class="shell utility-inner"><span>Banking in Papua New Guinea</span><div><a href="/about/locations">Locations</a><a href="/about/contact">Contact Us</a><a href="tel:16789"><Icon name="phone" size={14}/>16789 (DIGICEL)</a></div></div></div>
<header class="site-header"><div class="shell header-inner"><a href="/" class="logo" aria-label="MiBank home"><img src={asset('nmb_logo.gif')} width="200" height="70" alt="MiBank — Grow with us"/></a><button id="mobile-toggle" class="mobile-toggle" aria-expanded="false" aria-controls="primary-nav"><span>Menu</span><Icon name="menu"/></button>
<nav id="primary-nav" aria-label="Main navigation"><a class:list={['nav-home',{active:current==='/'}]} href="/" aria-current={current==='/'?'page':undefined}>Home</a>
<details class="nav-dropdown"><summary class:list={{active:current.startsWith('/products')}}>Products <Icon name="chevron" size={15}/></summary><div class="dropdown products-dropdown"><div class="dropdown-intro"><span class="eyebrow">MiBank Products</span><a href="/products">All products <Icon/></a><p>Simple hassle-free banking for everyone</p></div><div class="dropdown-links">{products.map(([name,url])=><a href={url} aria-current={current===url?'page':undefined}>{name}<span aria-hidden="true">↗</span></a>)}</div></div></details>
<details class="nav-dropdown"><summary class:list={{active:current.startsWith('/about')}}>About us <Icon name="chevron" size={15}/></summary><div class="dropdown about-dropdown">{about.map(([name,url])=><a href={url} aria-current={current===url?'page':undefined}>{name}</a>)}</div></details>
<a href="/media" class:list={{active:current.startsWith('/media')}} aria-current={current==='/media'?'page':undefined}>Media</a><a class="nav-contact" href="/about/contact">Contact Us <Icon name="arrow" size={18}/></a></nav></div></header>
<main id="main" tabindex="-1"><slot/></main>
<section class="callout"><div class="shell callout-inner"><div><span class="eyebrow">Contact Us</span><h2>CALL MIBANK TODAY!</h2></div><a href="tel:16789">16789 <span>(DIGICEL)</span><Icon size={30}/></a></div></section>
<footer><div class="shell"><div class="footer-top"><a class="footer-brand" href="/" aria-label="MiBank home"><img src={asset('nmb_logo.gif')} alt="MiBank — Grow with us" width="200" height="70"/></a><p>Simple hassle-free<br/>banking for everyone</p><a class="footer-location" href="/about/locations"><Icon name="pin"/>Locations <Icon name="arrow"/></a></div><div class="footer-grid"><div><a class="footer-heading" href="/products">Products</a><div class="footer-products">{products.map(([name,url])=><a href={url}>{name}</a>)}</div></div><div><a class="footer-heading" href="/about">About Us</a>{about.filter(([n])=>!['About Us','Contact Us'].includes(n)).map(([name,url])=><a href={url}>{name}</a>)}</div><div><a class="footer-heading" href="/about/contact">Contact Us</a><a href="tel:16789">16789 (DIGICEL)</a><a href="mailto:nmbho@mibank.com.pg">nmbho@mibank.com.pg</a><a href="/media">Media</a><div class="social"><a href="https://www.facebook.com/MiBank-PNG-206671296097574/" rel="noopener noreferrer">Facebook ↗</a><a href="https://twitter.com/#!/twestaway" rel="noopener noreferrer">Twitter ↗</a></div></div></div><div class="footer-bottom"><p>© ALL RIGHTS RESERVED NATIONWIDE MICROBANK (MiBank) LIMITED 2016</p><span>Non-production preview</span></div></div></footer>
<script>
import {gsap} from 'gsap';
const toggle=document.querySelector<HTMLButtonElement>('#mobile-toggle');const nav=document.querySelector<HTMLElement>('#primary-nav');
toggle?.addEventListener('click',()=>{const open=toggle.getAttribute('aria-expanded')!=='true';toggle.setAttribute('aria-expanded',String(open));nav?.classList.toggle('is-open',open);if(!open)document.querySelectorAll<HTMLDetailsElement>('.nav-dropdown').forEach(d=>d.open=false)});
document.querySelectorAll<HTMLDetailsElement>('.nav-dropdown').forEach(detail=>detail.addEventListener('toggle',()=>{if(detail.open)document.querySelectorAll<HTMLDetailsElement>('.nav-dropdown').forEach(other=>{if(other!==detail)other.open=false})}));
document.addEventListener('keydown',e=>{if(e.key==='Escape'){const open=document.querySelector<HTMLDetailsElement>('.nav-dropdown[open]');if(open){open.open=false;open.querySelector<HTMLElement>('summary')?.focus()}else if(toggle?.getAttribute('aria-expanded')==='true'){toggle.click();toggle.focus()}}});
document.addEventListener('click',e=>{document.querySelectorAll<HTMLDetailsElement>('.nav-dropdown[open]').forEach(d=>{if(!d.contains(e.target as Node))d.open=false})});
if(!matchMedia('(prefers-reduced-motion: reduce)').matches){gsap.fromTo('.hero-copy > *',{y:18},{y:0,duration:.75,stagger:.09,ease:'power2.out',clearProps:'all'});const observer=new IntersectionObserver(entries=>{entries.forEach(entry=>{if(entry.isIntersecting){gsap.fromTo(entry.target,{y:22},{y:0,duration:.65,ease:'power2.out',clearProps:'all'});observer.unobserve(entry.target)}})},{threshold:.08});document.querySelectorAll('[data-reveal]').forEach(el=>observer.observe(el));}
</script>
</body></html>
