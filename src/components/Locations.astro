---
import locations from '../data/locations.json';
---
<section class="location-directory"><div class="directory-heading"><h2>Locations</h2><p>Did you know that MiBank is in all these locations?</p></div><div class="directory-filters"><div><label for="location-search">Search locations</label><input id="location-search" type="search" placeholder="Branch, agent or place" autocomplete="off"/></div><div><label for="location-type">Location type</label><select id="location-type"><option value="all">All locations</option><option>Branches</option><option>Agents</option><option>Financial Literacy Training</option></select></div></div><p id="location-count" role="status" aria-live="polite">{locations.length} locations</p><ul class="location-list">{locations.map(l=><li data-location={l.name.toLowerCase()} data-type={l.type}><span>{l.name}</span><small>{l.type}</small></li>)}</ul><p id="no-locations" hidden>No matching locations.</p></section>
<script>
const search=document.querySelector<HTMLInputElement>('#location-search')!;const type=document.querySelector<HTMLSelectElement>('#location-type')!;function filter(){let count=0;document.querySelectorAll<HTMLElement>('[data-location]').forEach(el=>{const show=el.dataset.location?.includes(search.value.toLowerCase())&&(type.value==='all'||type.value===el.dataset.type);el.hidden=!show;if(show)count++});document.querySelector('#location-count')!.textContent=`${count} locations`;document.querySelector<HTMLElement>('#no-locations')!.hidden=count>0;}search?.addEventListener('input',filter);type?.addEventListener('change',filter);
</script>
