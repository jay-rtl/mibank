---
import {parseMedia} from '../lib/media';
import Icon from './Icon.astro';
import '../styles/media.css';
const {source}=Astro.props;
const {intro,items,featured,archive,years}=parseMedia(source);
---
<section class="newsroom shell" aria-label="MiBank media">
 <div class="newsroom-intro">
  <div class="newsroom-introduction" set:html={intro}/>
  <div class="newsroom-search"><label for="media-search">Search media</label><input id="media-search" type="search" placeholder="Search news, reports or a year" autocomplete="off"/><p id="media-count" role="status" aria-live="polite">{items.length} news and report items</p></div>
 </div>
 <article class="news-feature" id={featured.id} data-news-item data-search={featured.text.toLowerCase()} data-year={featured.year}>
  {featured.image&&<a class="news-feature-image" href={featured.image.href} aria-label={featured.image.alt}><img src={featured.image.src} alt={featured.image.alt} width={featured.image.width} height={featured.image.height} fetchpriority="high" decoding="async"/></a>}
  <div class="news-feature-copy"><div class="news-feature-kicker"><span class="eyebrow">Media</span><span>{featured.year}</span></div><div class="news-original" set:html={featured.html}/><div class="news-feature-end"><span>{featured.href.endsWith('.pdf')?'PDF':'Article'}</span><Icon name="arrow" size={25}/></div></div>
 </article>
 <div class="news-archive-heading" id="media-archive"><h2>Media archive</h2><a class="text-link" href="/about/annual-reports">Annual Reports <Icon size={16}/></a></div>
 <div class="news-archive-grid"><nav class="news-year-nav" aria-label="Media archive years"><span class="eyebrow">Archive</span>{years.map(year=><a href={`#media-${year}`} data-year-link={year}><span>{year}</span><span>{archive.filter(item=>item.year===year).length.toString().padStart(2,'0')}</span></a>)}</nav>
 <div class="news-year-groups">{years.map(year=><section class="news-year-group" id={`media-${year}`} data-year-group={year} aria-labelledby={`media-heading-${year}`}><div class="news-year-heading"><h3 id={`media-heading-${year}`}>{year}</h3><span>MiBank · Media</span></div><div class="news-entries">{archive.filter(item=>item.year===year).map(item=><article class:list={['news-entry',{'news-entry-illustrated':Boolean(item.image)}]} id={item.id} data-news-item data-search={item.text.toLowerCase()} data-year={item.year}>{item.image&&<a class="news-entry-image" href={item.image.href} aria-label={item.image.alt}><img src={item.image.src} alt={item.image.alt} width={item.image.width} height={item.image.height} loading="lazy" decoding="async"/></a>}<div class="news-original" set:html={item.html}/><span class="news-entry-arrow" aria-hidden="true">↗</span></article>)}</div></section>)}</div></div>
 <div class="news-empty" id="media-empty" hidden><p>No matching media items.</p><button id="media-reset" type="button">Show all media</button></div>
 <noscript><style>.newsroom-search{display:none}</style></noscript>
</section>
<script>
const input=document.querySelector<HTMLInputElement>('#media-search');
if(input){const items=[...document.querySelectorAll<HTMLElement>('[data-news-item]')];const filter=()=>{let count=0;const query=input.value.toLowerCase().trim();items.forEach(item=>{const show=item.dataset.search?.includes(query)??false;item.hidden=!show;if(show)count++});document.querySelectorAll<HTMLElement>('[data-year-group]').forEach(group=>{const visible=Boolean(group.querySelector('[data-news-item]:not([hidden])'));group.hidden=!visible;const link=document.querySelector<HTMLElement>(`[data-year-link="${group.dataset.yearGroup}"]`);if(link)link.hidden=!visible});document.querySelector('#media-count')!.textContent=`${count} news and report items`;document.querySelector<HTMLElement>('#media-empty')!.hidden=count>0;document.querySelector<HTMLElement>('.news-archive-heading')!.hidden=!document.querySelector('[data-year-group]:not([hidden])');document.querySelector<HTMLElement>('.news-year-nav')!.hidden=!document.querySelector('[data-year-group]:not([hidden])')};input.addEventListener('input',filter);document.querySelector('#media-reset')?.addEventListener('click',()=>{input.value='';filter();input.focus()})}
</script>
