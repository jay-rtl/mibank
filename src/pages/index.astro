---
import Layout from '../layouts/Layout.astro';import Icon from '../components/Icon.astro';import {asset,products,pages} from '../lib/content';
import {load} from 'cheerio';
const home=pages.find(p=>p.route==='/')!;const $=load(home.html);const intro=$('p').filter((_,el)=>$(el).text().startsWith('MiBank delivers')).first().text();
const promo=[['Hibiscus Card','/media/hibiscus','products_hibiscus_c.jpg'],['MiCash','https://play.google.com/store/apps/details?id=com.mibank.micash.customer','products_mibank_app.jpg'],['Business Loan',asset('MiBank_SME_Loan_app_08-22_3.pdf'),'buiness_loan_app.jpg'],['MiCard','/products/micard','products_micard_b.jpg']];
const videos=[['MiBank - Agent','/media/micash-agent','video_mibank_agent.jpg'],['MiBank - ULIP','/media/ulip','video_mibank_ulip.jpg'],['MiBank - Hibicus Card','/media/hibiscus','video_mibank_hibicus.jpg']];
---
<Layout title="Banking in Papua New Guinea" description="MiBank delivers modern and affordable, savings, loans and insurance products, from a network of 16 branches and many agents across Papua New Guinea.">
<section class="hero"><div class="shell hero-grid"><div class="hero-copy"><div class="eyebrow"><span class="tiny-square"></span>MiBank · Papua New Guinea</div><h1>Simple<br/>hassle-free<br/>banking for<br/> <em>everyone</em></h1><div class="hero-actions"><a class="button button-dark" href="/products">Products <Icon/></a><a class="text-link" href="/about">About Us <Icon/></a></div><div class="hero-note"><span class="line"></span><span>GROW WITH US</span></div></div><div class="hero-visual"><picture><source type="image/avif" srcset="/assets/hibiscus-hero-640.avif 640w, /assets/hibiscus-hero-960.avif 960w, /assets/hibiscus-hero-1422.avif 1422w" sizes="(max-width: 520px) 140vw, (max-width: 800px) 80vw, 55vw"/><img class="hero-photo" src={asset('video_mibank_hibicus.jpg')} width="1422" height="906" fetchpriority="high" alt="MiBank Hibiscus Card customer in Papua New Guinea"/></picture><div class="image-tag"><span class="tag-dot"></span>MiBank — Hibiscus Card</div><a class="hero-play" href="/media/hibiscus" aria-label="Watch MiBank Hibiscus Card video"><Icon name="play" size={22}/></a><div class="hero-image-caption"><span>01 / MiBank</span><span>GROW WITH US ↗</span></div></div></div></section>
<div class="quick-nav shell"><a href="/products/micash"><span class="quick-number">01</span><span>MiCash</span><Icon/></a><a href="/products/micard"><span class="quick-number">02</span><span>MiCard</span><Icon/></a><a href="/products/business-loan"><span class="quick-number">03</span><span>Business Loan</span><Icon/></a><a href="/about/locations"><Icon name="pin"/><span>Locations</span><Icon/></a></div>
<section class="section products-section shell" data-reveal><div class="section-heading"><div><span class="eyebrow">MiBank Products</span><h2>GROW WITH US</h2></div><a class="text-link" href="/products">Products <Icon/></a></div><div class="product-showcase">{products.filter((_,i)=>[0,4,6,10].includes(i)).map(([name,url,img],i)=><a class="product-editorial" href={url}><div class="product-image"><img src={asset(img)} width="300" height="300" loading="lazy" alt={name}/><span class="product-arrow"><Icon/></span></div><span class="product-index">0{i+1}</span><h3>{name}</h3></a>)}</div><div class="product-text-links">{products.filter((_,i)=>![0,4,6,10].includes(i)).map(([name,url])=><a href={url}>{name}<span aria-hidden="true">↗</span></a>)}</div></section>
<section class="bank-story" data-reveal><div class="shell story-grid"><div><span class="eyebrow">About MiBank</span><h2>Banking in<br/>Papua New Guinea.</h2><a class="text-link" href="/about">About Us <Icon/></a></div><div class="story-copy"><p>{intro}</p><a class="text-link" href="/about/vision-mission">Vision/Mission <Icon/></a></div></div></section>
<section class="section shell" data-reveal><div class="section-heading"><div><span class="eyebrow">MiBank</span><h2>GROW WITH US</h2></div></div><div class="promotion-strip">{promo.map(([name,url,img])=><a href={url} aria-label={name}><img src={asset(img)} alt={name} width="300" height="300" loading="lazy"/></a>)}</div></section>
<section class="video-section section" data-reveal><div class="shell"><div class="section-heading"><div><span class="eyebrow">MiBank</span><h2>MiBank Feature Videos</h2></div><a class="text-link" href="/media">Media <Icon/></a></div><div class="feature-videos">{videos.map(([name,url,img])=><a href={url}><div class="video-thumb"><img src={asset(img)} alt={name} width="1422" height="906" loading="lazy"/><span class="play-circle"><Icon name="play"/></span></div><h3>{name}<Icon/></h3></a>)}</div><a class="choice-link" href="/media/michoice"><img src={asset('products_michoice.jpg')} width="300" height="300" loading="lazy" alt="Get a MiCard or MiCash on your mobile"/><span>MiBank Choice</span><Icon/></a></div></section>
<section class="news-callout shell section" data-reveal><span class="eyebrow">Media</span><div><h2>MiBank appointments<br/>Mr. Trudi Egi as new CEO</h2><p>Port Moresby 25 November 2024</p></div><a href="/media" class="button button-dark">Media <Icon/></a><a class="original-news" href="/media"><img src={asset('mibank_news_btn.jpg')} width="300" height="300" loading="lazy" alt="MiBank News"/></a></section>
</Layout>
