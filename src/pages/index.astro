---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import HomeSlideshow from '../components/HomeSlideshow.astro';
import {asset,products,pages} from '../lib/content';
import {load} from 'cheerio';
import '../styles/home.css';
const home=pages.find(p=>p.route==='/')!;
const $=load(home.html);
const intro=$('p').filter((_,el)=>$(el).text().startsWith('MiBank delivers')).first().text();
const missionSource=load(pages.find(p=>p.route==='/about/vision-mission')!.html);
const mission=missionSource('h2').filter((_,el)=>missionSource(el).text()==='Our Mission').next('p').text();
const featured=[
  {name:'MiCash',caption:'Mobile banking',url:'https://play.google.com/store/apps/details?id=com.mibank.micash.customer',image:'products_mibank_app.jpg',cta:'Explore the app'},
  {name:'MiCard',caption:'Everyday banking',url:'/products/micard',image:'products_micard_b.jpg',cta:'Explore MiCard'},
  {name:'Business Loan',caption:'Business banking',url:asset('MiBank_SME_Loan_app_08-22_3.pdf'),image:'buiness_loan_app.jpg',cta:'Download application'}
];
const videos=[['MiBank - Agent','/media/micash-agent','video_mibank_agent.jpg'],['MiBank - ULIP','/media/ulip','video_mibank_ulip.jpg'],['MiBank - Hibicus Card','/media/hibiscus','video_mibank_hibicus.jpg']];
const reportSource=load(pages.find(p=>p.route==='/about/annual-reports')!.html);
const reports=reportSource('img').toArray().filter(img=>reportSource(img).attr('alt')?.startsWith('Financial Statements')).map(img=>({title:reportSource(img).attr('alt')!,image:reportSource(img).attr('src')!,url:reportSource(img).closest('a').attr('href')!})).slice(0,3);
---
<Layout homeTheme title="Banking in Papua New Guinea" description="MiBank delivers modern and affordable, savings, loans and insurance products, from a network of 16 branches and many agents across Papua New Guinea.">
  <HomeSlideshow/>
  <section class="cinema-mission cinema-section shell" aria-labelledby="mission-title">
    <span class="cinema-kicker">Banking with purpose</span><h2 id="mission-title">Our Mission</h2><p class="mission-statement">{mission}</p><a class="cinema-link" href="/about/vision-mission">Our vision &amp; values <Icon/></a>
    <div class="cinema-products">{featured.map((item,i)=><a class:list={['cinema-product',{'cinema-product-lowered':i===1}]} href={item.url} rel={item.url.startsWith('https:')?'noopener noreferrer':undefined}>
      <div class="cinema-product-art"><img src={asset(item.image)} width="300" height="300" loading="lazy" alt={item.name}/><span class="cinema-product-number" aria-hidden="true">0{i+1}</span></div><span class="cinema-kicker">{item.caption}</span><h3>{item.name}</h3><span class="cinema-product-cta">{item.cta}<Icon size={17}/></span>
    </a>)}</div>
    <div class="cinema-product-directory"><span class="cinema-kicker">MiBank Products</span><div>{products.map(([name,url])=><a href={url}>{name}<span aria-hidden="true">↗</span></a>)}</div></div>
  </section>
  <section class="cinema-story cinema-section" aria-labelledby="story-title"><div class="shell cinema-story-grid"><div class="cinema-story-image"><img src={asset('Umi market_10-24.jpg')} width="1024" height="768" loading="lazy" alt="MiBank community gathering at Umi market"/><span class="cinema-photo-caption">MiBank · Papua New Guinea</span></div><div class="cinema-story-copy"><span class="cinema-kicker">Grow with us</span><h2 id="story-title">Banking in<br/>Papua New Guinea.</h2><p>{intro}</p><a class="cinema-link" href="/about">About MiBank <Icon/></a></div></div></section>
  <section class="cinema-reports cinema-section shell" aria-labelledby="reports-title"><div class="cinema-section-heading"><div><span class="cinema-kicker">Shareholder information</span><h2 id="reports-title">Our Annual Reports</h2></div><a class="cinema-link" href="/about/annual-reports">All reports <Icon/></a></div><div class="cinema-report-grid">{reports.map(report=><a href={report.url} class="cinema-report"><div class="cinema-report-cover"><img src={report.image} width="522" height="460" loading="lazy" alt={report.title}/></div><h3>{report.title}</h3><span>Download PDF <Icon name="download" size={17}/></span></a>)}</div></section>
  <section class="cinema-hibiscus" aria-labelledby="hibiscus-title"><div class="shell cinema-hibiscus-inner"><div><span class="cinema-kicker">MiBank Hibiscus Card</span><h2 id="hibiscus-title">Simple hassle-free<br/>banking for everyone</h2><a class="cinema-button" href="/media/hibiscus"><Icon name="play" size={17}/> Watch the story</a></div><a href="/media/hibiscus" class="cinema-hibiscus-art" aria-label="Explore MiBank Hibiscus Card"><img src={asset('products_hibiscus_c.jpg')} width="300" height="300" loading="lazy" alt="Hibiscus Card"/></a></div></section>
  <section class="cinema-films cinema-section shell" aria-labelledby="films-title"><div class="cinema-section-heading"><div><span class="cinema-kicker">Stories from MiBank</span><h2 id="films-title">MiBank Feature Videos</h2></div><a class="cinema-link" href="/media">Media <Icon/></a></div><div class="cinema-film-grid">{videos.map(([name,url,image])=><a class="cinema-film" href={url}><div class="cinema-film-photo"><img src={asset(image)} width="1422" height="906" loading="lazy" alt={name}/><span class="cinema-play"><Icon name="play"/></span></div><h3>{name}<Icon size={18}/></h3></a>)}</div><a href="/media/michoice" class="cinema-choice"><img src={asset('products_michoice.jpg')} width="300" height="300" loading="lazy" alt="Get a MiCard or MiCash on your mobile"/><span>MiBank Choice</span><Icon/></a></section>
  <section class="cinema-news shell" aria-labelledby="news-title"><div><span class="cinema-kicker">From the newsroom</span><h2 id="news-title">MiBank appointments<br/>Mr. Trudi Egi as new CEO</h2><p>Port Moresby 25 November 2024</p><a href="/media" class="cinema-link">Visit the newsroom <Icon/></a></div><a href="/media" class="cinema-news-art"><img src={asset('Retirement_11-24.jpg')} width="1024" height="768" loading="lazy" alt="MiBank leadership news photograph"/><span>News archive <Icon size={18}/></span></a></section>
</Layout>
