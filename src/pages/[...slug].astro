---
import Layout from '../layouts/Layout.astro';import Icon from '../components/Icon.astro';import Locations from '../components/Locations.astro';import {pages,products,about,asset} from '../lib/content';
import Artwork from '../components/Artwork.astro';
import MediaArchive from '../components/MediaArchive.astro';
import '../styles/locations.css';
import {load} from 'cheerio';
export function getStaticPaths(){return pages.filter(p=>p.route!=='/').map(page=>({params:{slug:page.route.slice(1)},props:{page}}))}
const {page}=Astro.props;const isProducts=page.route==='/products';const isProduct=page.route.startsWith('/products/');const isLocations=page.route==='/about/locations';const section=isProduct?'Products':page.route.startsWith('/media')?'Media':'About us';const links=isProduct?products:about;const isPeople=/directors|management/.test(page.route);const isMedia=page.route==='/media';
let sourceContent=page.html;
if(isLocations){const content=load(sourceContent);content('body').children().first().remove();sourceContent=content('body').html()||'';}
---
<Layout title={page.title} description={`${page.title} — MiBank. ${page.description}`.slice(0,200)}>
<div class="page-heading"><div class="shell"><nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span>{isProduct&&<><a href="/products">Products</a><span aria-hidden="true">/</span></>}<span aria-current="page">{page.title}</span></nav><div class="page-heading-row"><div><span class="eyebrow">MiBank · {section}</span><h1>{page.title}</h1></div><span class="page-marker" aria-hidden="true">↗</span></div></div></div>
{isMedia?<MediaArchive source={page.html}/>:<>
{isProducts?<section class="section shell"><div class="all-products">{products.map(([name,url,img],i)=><a class="product-row" href={url}><span class="row-index">{String(i+1).padStart(2,'0')}</span><img src={asset(img)} width="300" height="300" loading="lazy" alt={name}/><h2>{name}</h2><Icon size={28}/></a>)}</div><div class="source-content product-source" set:html={page.html}/><Artwork/></section>:<div class:list={['shell page-grid',{'wide-content':isPeople||isMedia}]}><aside class="page-sidebar"><span class="eyebrow">{section}</span><nav aria-label={`${section} pages`}>{links.map(([name,url])=><a href={url} aria-current={url===page.route?'page':undefined}>{name}<span aria-hidden="true">↗</span></a>)}</nav><a href="/about/contact" class="sidebar-contact"><Icon name="phone"/>Contact Us<Icon/></a></aside><article class:list={['page-article',{'people-page':isPeople,'media-page':isMedia,'locations-page':isLocations,'reports-page':page.route.includes('annual-reports'),'contact-page':page.route==='/about/contact'}]}>
{page.route==='/about'&&<div class="about-links">{about.filter(([name])=>name!=='About Us').map(([name,url])=><a href={url}>{name}<Icon size={16}/></a>)}</div>}
{isLocations&&<Locations/>}
<div class="source-content" data-source-route={page.route} set:html={sourceContent}/>
{page.videos.map(v=><div class="local-video"><video controls preload="none" playsinline aria-label={v.title} poster={asset(page.route.endsWith('hibiscus')?'video_mibank_hibicus.jpg':page.route.endsWith('micash-agent')?'video_mibank_agent.jpg':page.route.endsWith('ulip')?'video_mibank_ulip.jpg':'products_michoice.jpg')}><source src={v.src} type="video/mp4"/><p>{v.title}</p></video>{page.route==='/media/hibiscus'&&<h2 class="video-caption">Simple hassle-free banking for everyone</h2>}<p>{v.title} · <a href={v.src}>Download video</a></p>{page.route!=='/media/hibiscus'&&<p class="preview-note">Original video. Captions and transcript were not provided in the source website.</p>}</div>)}
<div class="article-end"><span>MiBank</span><a class="text-link" href="/about/contact">Contact Us <Icon/></a></div></article></div>}
</>}
</Layout>
<style>.video-caption{font-size:clamp(24px,3vw,36px);line-height:1.25;margin-top:26px;letter-spacing:-.035em}</style>
